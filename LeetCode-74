class Solution {
    public boolean searchMatrix(int[][] arr, int target) {
        int row=arr.length;
        int cols=arr[0].length;
        int lo=0;
        int hi=row*cols-1;
        while(lo<=hi)
        {
            int mid=(lo+hi)/2;
            int rowMid=mid/cols;
            int colsMid=mid%cols;
            if(arr[rowMid][colsMid]==target)
            return true;
            else if(arr[rowMid][colsMid]>target) hi=mid-1;
            else lo=mid+1;
        }
        return false;
    }
}
